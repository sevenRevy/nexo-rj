# Embeddings: padrão Q8 compatível com runtime_bundle.json.
# Suba o llama-server com o GGUF oficial; veja ../docs/EXECUCAO_LOCAL.md.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=Qwen3-Embedding-0.6B.Q8_0
OLLAMA_LOCAL_URL=http://127.0.0.1:18321/v1
OLLAMA_LOCAL_API_KEY=ollama
OLLAMA_LOCAL_EMBEDDING_MODEL=Qwen3-Embedding-0.6B.Q8_0
QUERY_EMBEDDING_TIMEOUT=8
QUERY_EMBEDDING_COOLDOWN=30
DENSE_RETRIEVAL_ENABLED=true
# Outro encoder exige reindexação ou comprovação de compatibilidade, não apenas mesma dimensão.

# Geração: configure sua própria chave OpenRouter; nunca use VITE_* para segredos.
LLM_PROVIDER_MODE=openrouter
OPENROUTER_API_KEY=
OPENROUTER_MODEL=xiaomi/mimo-v2.6-flash
OPENROUTER_MODEL_FALLBACK=openrouter/free
OPENROUTER_MAX_TOKENS=4096
OPENROUTER_TIMEOUT=60
# Alternativa: LLM_PROVIDER_MODE=auto usa este endpoint OpenAI-compatible primeiro.
# É um serviço de geração separado do servidor Q8 de embeddings.
OLLAMA_URL=http://localhost:11434/v1
OLLAMA_API_KEY=ollama
GENERATION_MODEL=qcwind/qwen3-8b-instruct-Q4-K-M
GENERATION_CONTEXT_CHARS=12000
GENERATION_CHUNK_CHARS=900
GENERATION_TIMEOUT=180
GENERATION_MAX_RETRIES=1
LLM_TEMPERATURE=0
MODEL_MIN_INTERVAL_SECONDS=10
CONVERSATION_MODE=llm
REFORMULACAO_MODE=llm
REFORMULACAO_TIMEOUT=60
QUERY_ANALYSIS_MODE=regras
SQL_APRESENTACAO_LLM=false
INDEX_PRELOAD=true

# Rerank local: os pesos são baixados separadamente, não pertencem ao Git.
RERANK_ENABLED=true
RERANK_PROVIDER=local
RERANK_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1
RERANK_CANDIDATES=10
RERANK_MAX_LENGTH=512
RERANK_PRELOAD=true
RETRIEVAL_MAX_PER_PURCHASE=2

# Presets opcionais de embeddings; não misture vetores de modelos diferentes.
OPENAI_API_URL=https://api.openai.com/v1
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CUSTOM_API_URL=
CUSTOM_API_KEY=
CUSTOM_EMBEDDING_MODEL=Qwen3-Embedding-0.6B.Q8_0

# Corpus externo ao Git: extraia o pacote Q8 dentro de backend/.
SNAPSHOT_MANIFEST=runtime_bundle.json
# Vazio usa SQLite local; configure somente para usar Postgres.
DATABASE_URL=
REQUEST_TIMEOUT=30
REQUEST_ATTEMPTS=3
TESSERACT_CMD=
OCR_LANG=por
OCR_DPI=300
VALUE_REVIEW_THRESHOLD=1000000000

# localhost:5173 e 127.0.0.1:5173 já estão liberados.
# Adicione somente as origens públicas que você realmente controla.
CORS_ALLOW_ORIGINS=
RAG_API_KEY=
HISTORY_PUBLIC=false
API_DOCS=true
RATE_LIMIT_QUERY_PER_MINUTE=10
RATE_LIMIT_READ_PER_MINUTE=120
HISTORY_RETENTION_DAYS=30
LOG_CHAIN_ENABLED=true
LOG_CHAIN_KEY=
LOG_RETENTION_DAYS=30
LOG_EVIDENCE_DETAIL=resumo
MAINTENANCE_RETENTION_DAYS=14
